{
  "title": "Grid Layout Test",
  "sections": [
    {
      "title": "Profile",
      "gridPosition": { "row": 1, "col": 1, "rowSpan": 2, "colSpan": 1 },
      "fields": [
        { "key": "firstName", "label": "First Name", "type": "text", "required": true },
        { "key": "lastName", "label": "Last Name", "type": "text", "required": true },
        { "key": "email", "label": "Email", "type": "email" },
        {
          "key": "hobbies",
          "label": "Hobbies",
          "type": "checkbox",
          "direction": "horizontal",
          "options": ["Reading", "Traveling", "Cooking", "Gaming"]
        },
        {
          "key": "newsletter",
          "label": "Subscribe to newsletter",
          "type": "checkbox",
          "options": null
        }
      ]
    },
    {
      "title": "Preferences",
      "gridPosition": { "row": 1, "col": 2, "rowSpan": 1, "colSpan": 2 },
      "fields": [
        {
          "key": "contactMethod",
          "label": "Contact Method",
          "type": "radio",
          "options": ["Email", "Phone", "SMS"]
        },
        { "key": "subscribe", "label": "Subscribe", "type": "checkbox", "options": ["Yes"] },
        {
          "key": "contactMethod2",
          "label": "Contact Method2",
          "type": "radio",
          "direction": "horizontal",
          "options": ["Email", "Phone", "SMS"]
        }
      ]
    },
    {
      "title": "Additional Info",
      "gridPosition": { "row": 2, "col": 2, "rowSpan": 1, "colSpan": 1 },
      "fields": [{ "key": "bio", "label": "Short Bio", "type": "textarea" }]
    },
    {
      "title": "Status",
      "gridPosition": { "row": 2, "col": 3, "rowSpan": 2, "colSpan": 1 },
      "fields": [
        {
          "key": "employmentStatus",
          "label": "Employment Status",
          "type": "select",
          "options": ["Employed", "Unemployed", "Student"]
        }
      ]
    },
    {
      "title": "Notes",
      "gridPosition": { "row": 3, "col": 1, "rowSpan": 1, "colSpan": 2 },
      "fields": [{ "key": "notes", "label": "Notes", "type": "textarea" }]
    }
  ]
}
